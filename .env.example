# =====================================================
# InvestorDocs AI — Backend environment template
# Copy to `.env` and fill in real values.
# =====================================================

# App
ENVIRONMENT=development
DEBUG=true

# Database (async for SQLAlchemy, psycopg for vector store)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investordocs
VECTOR_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/investordocs

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend (used for email links + Google OAuth redirects)
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# AI / RAG
OPENAI_API_KEY=            # optional — OpenAI embeddings; voice transcription is now fully local (Faster-Whisper)
OPENROUTER_API_KEY=        # used by the RAG LLM and vision image analysis
OPENROUTER_API_BASE=https://api.openrouter.ai/v1
EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=small              # Faster-Whisper (local): tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu               # cpu | cuda
WHISPER_COMPUTE_TYPE=int8        # int8 | float16 | float32
VISION_MODEL=openai/gpt-4o-mini

# Google OAuth
GOOGLE_CLIENT_ID=          # OAuth client ID (Web application)
GOOGLE_CLIENT_SECRET=      # only needed for the server redirect flow
GOOGLE_REDIRECT_URI=       # e.g. http://localhost:8000/api/auth/google/callback

# Email / SMTP (verification + login-notification emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Email retry scheduler (failed emails are re-sent in the background)
EMAIL_RETRY_INTERVAL_MINUTES=10
EMAIL_MAX_RETRIES=5
EMAIL_OUTBOX_RETENTION_DAYS=7

# Feature flags
LOGIN_NOTIFICATION_ENABLED=true
IP_GEOLOCATION_ENABLED=true
VERIFICATION_TOKEN_EXPIRE_HOURS=24
MAX_AUDIO_UPLOAD_MB=25
MAX_IMAGE_UPLOAD_MB=10

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
